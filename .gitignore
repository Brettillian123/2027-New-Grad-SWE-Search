# Never commit personal documents. Resumes carry a phone number, an email and a
# home city; this repo is public.
resumes/
*_Resume.*
*_Anderson_*.md
*.docx
*.pdf

# Bulk scan output: ~17 MB, regenerated by every run.
scan_*.json
scan_*.log
fresh_*.json
bench_*.json
b_wd*.json
fair_*.json
tier_*.json
new_ats.json
newboard_kept.json
candidates.json
board_postings.json
repay_out.json

# Local run state.
board_tiers.json
board_state.json
probe_names.json
probe.log
*.bak
*.bak2

# Env
__pycache__/
*.pyc
node_modules/
package-lock.json

# Archives hide PII from a text grep. job-applications-skill.zip contains
# master_resume.md with a phone number, an email and a GPA, and it sailed past a
# content scan because zip is binary.
*.zip
*.tar
*.tar.gz

# build_resume.js hardcodes the contact block - phone number and email - inside
# the docx template. md2docx.js is the parameterised replacement and is safe.
build_resume.js

# Personal job-search material, not scanner code.
recruiter_outreach_templates.md
job-applications-skill.zip
# Common Crawl index cache: ~100 MB, re-downloaded by ccharvest.py on demand.
cluster_*.idx

# Harvest intermediates. ccharvest.py regenerates these in seconds; only the
# VALIDATED target lists are worth tracking.
cc_candidates.json
cc_all.json
cc_more.json
cc_sample.json
cc_wd_candidates.json
cc_wd_cands.json
sample_targets.json

# Editing backups
*.bak
*.bak2
*.bak3
*.bak4

# Run logs
refresh_run*.log
refresh_full.log
validate*.log
